# File download credentials
# If files are behind auth, set Authorization header value
FILE_AUTH_HEADER=

# OpenAI (optional — swap for any LangChain-compatible LLM)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Tesseract binary path (if not in PATH)
# TESSERACT_CMD=/usr/local/bin/tesseract

# Poppler path for pdf2image (macOS: brew install poppler)
# POPPLER_PATH=/opt/homebrew/bin

# Max concurrent file downloads
MAX_DOWNLOAD_CONCURRENCY=5

# Max file size to download (bytes), default 2GB
MAX_FILE_BYTES=2147483648
